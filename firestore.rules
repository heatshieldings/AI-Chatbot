rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: chats
    // Document ID: sessionId
    // Fields:
    //   - startTime: timestamp (required)
    //   - lastUpdateTime: timestamp (required)
    //   - messages: list of objects (required)
    //   - detectedLanguage: string (optional)
    //   - userAgent: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.lower() == "info@heatshieldings.com");
    }

    function isValidChat(data) {
      // Simplified validation to prevent rejection of partial updates
      return data.messages is list &&
             data.messages.size() < 500;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /chats/{sessionId} {
      // Allow anyone to create/update a chat session
      allow create, update: if true; 
      
      // Allow getting a specific chat by ID
      allow get: if true;
      
      // Only admin can list/query all chats or delete them
      allow list, delete: if isAdmin();
    }

    match /error_reports/{reportId} {
      // Anyone can create an error report
      allow create: if true;
      // Only admin can read or delete reports
      allow read, list, delete: if isAdmin();
    }
  }
}
